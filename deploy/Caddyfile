# TLS + reverse proxy for the Octillion server.
# Upstreams are every replica of the `octillion` service (Docker DNS), re-resolved each second, so a rolling deploy can
# run the new replica next to the old one. A draining replica refuses new connections: Caddy retries the request on
# another replica and stops picking the refused one for a while. In-flight responses (model streams) are never moved.
{$DOMAIN:localhost} {
	reverse_proxy {
		dynamic a {
			name octillion
			port 3333
			refresh 1s
		}
		lb_try_duration 20s
		lb_try_interval 250ms
		fail_duration 10s
		max_fails 1
		flush_interval -1
	}
}

# Consenzy (consent-data-master), deployed on this VM: API and portal listen only on the docker0 address.
consenzy.onfinance.ai {
	log
	request_body {
		max_size 2MB
	}
	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	route {
		respond /v1/admin* 404
		reverse_proxy /v1/* 172.17.0.1:18000
		reverse_proxy /healthz 172.17.0.1:18000
		reverse_proxy /openapi.json 172.17.0.1:18000
		reverse_proxy 172.17.0.1:13100
	}
}
