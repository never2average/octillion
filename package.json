{
  "name": "octillion",
  "version": "2.0.0",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/http.ts",
    "start:stdio": "tsx --env-file-if-exists=.env src/stdio.ts",
    "dev": "OCTILLION_PREVIEW=1 tsx --env-file-if-exists=.env src/http.ts",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down",
    "db:reset": "tsx --env-file-if-exists=.env scripts/reset-db.ts",
    "org:create": "tsx --env-file-if-exists=.env scripts/create-org.ts",
    "access:list": "tsx --env-file-if-exists=.env scripts/access-requests.ts",
    "demo:seed": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p orchestrator",
    "vault:sync": "tsx --env-file-if-exists=.env scripts/vault-sync.ts",
    "fleet:status": "tsx --env-file-if-exists=.env scripts/fleet-status.ts",
    "orchestrator:install": "npm --prefix orchestrator ci",
    "keyvault": "tsx --env-file-if-exists=.env scripts/keyvault.ts",
    "population": "tsx --env-file-if-exists=.env scripts/population.ts"
  },
  "description": "Octillion: measure whether AI coding agents recommend your developer tool. MCP server + dashboard for Claude and ChatGPT.",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@clickhouse/client": "^1.24.1",
    "@electric-sql/pglite": "^0.5.8",
    "@mcp-ui/server": "^6.1.0",
    "@modelcontextprotocol/ext-apps": "^0.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
